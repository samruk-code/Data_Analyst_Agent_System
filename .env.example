# Required to run the agent (query generation, planning, critic, narrative).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enable LangSmith tracing + evals. Without these, evals/run_evals.py
# still runs (locally, no upload) and the graph still runs (just untraced).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=data-analyst-agent

# Optional overrides (defaults shown).
# DAA_STRONG_MODEL=claude-opus-5
# DAA_CHEAP_MODEL=claude-haiku-4-5
# DAA_MAX_QUERY_ATTEMPTS=3
# DAA_SQL_TIMEOUT_S=10
# DAA_CONTROL_TOTAL_TOLERANCE=0.15
